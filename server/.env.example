# Supabase: Project Settings > Database > Connection string > Session pooler
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
DB_SSL=true            # use false para PostgreSQL local na intranet
PORT=3001
# HTTPS direto no Node (opcional; em hospedagem tipo Render/Railway o HTTPS ja vem pronto)
# SSL_KEY_FILE=/caminho/chave.pem
# SSL_CERT_FILE=/caminho/certificado.pem
# Administrador inicial (sn1077068) ja vem no schema.sql. Variaveis abaixo so servem para criar outro admin se nao existir nenhum.
# ADMIN_NIF=admin
# ADMIN_NOME=Administrador
# ADMIN_SENHA=trocar-esta-senha
